# Backend
CAIS_ENV=development
CAIS_DATABASE_PATH=/app/data/cais.db
CAIS_CORS_ORIGINS=http://localhost:5500,https://seu-projeto.vercel.app
CAIS_SESSION_HOURS=12
CAIS_SEED_DEMO_DATA=true
CAIS_INGEST_API_KEY=troque-esta-chave-de-ingestao

# Limiares do score local
CAIS_RISK_MEDIUM_THRESHOLD=0.35
CAIS_RISK_HIGH_THRESHOLD=0.65

# Relatórios gerenciais — agenda diária, consolidando os últimos 7 dias
CAIS_REPORT_SCHEDULE_ENABLED=true
CAIS_REPORT_INTERVAL_SECONDS=86400
CAIS_REPORT_LOOKBACK_DAYS=7
CAIS_REPORT_RUN_ON_STARTUP=true
CAIS_REPORT_STARTUP_DELAY_SECONDS=2

# Gemini — em auto, a ausência/falha da chave ativa o fallback local
GEMINI_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Túnel HTTPS
NGROK_AUTHTOKEN=
