{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/gestor", "destination": "/gestor.html" },
    { "source": "/guarda", "destination": "/guarda.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
